    "reviewer": {
      "description": "Performs evidence-based, read-only review against the accepted plan and verification results.",
      "mode": "subagent",
      "model": "openai/gpt-6-astra",
      "request": {
        "body": {
          "temperature": 0.1,
          "reasoningEffort": "high",
          "textVerbosity": "low",
        },
      },
      "permissions": [
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "glob", "resource": "*", "effect": "allow" },
        { "action": "grep", "resource": "*", "effect": "allow" },
        { "action": "lsp", "resource": "*", "effect": "allow" },
        { "action": "git_inspect", "resource": "*", "effect": "allow" },
        { "action": "skill", "resource": "*", "effect": "allow" },
        { "action": "plan_read", "resource": "*", "effect": "allow" },
        { "action": "delegation_read", "resource": "*", "effect": "allow" },
        { "action": "delegation_list", "resource": "*", "effect": "allow" },
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "deny" },
        {
          "action": "shell",
          "resource": "git -C * status*",
          "effect": "allow",
        },
        { "action": "shell", "resource": "git -C * diff *", "effect": "allow" },
        { "action": "shell", "resource": "git -C * log *", "effect": "allow" },
        { "action": "shell", "resource": "git -C * show *", "effect": "allow" },
        {
          "action": "shell",
          "resource": "git -C * rev-parse *",
          "effect": "allow",
        },
        {
          "action": "shell",
          "resource": "git -C * ls-tree *",
          "effect": "allow",
        },
        {
          "action": "shell",
          "resource": "git -C * merge-base *",
          "effect": "allow",
        },
        {
          "action": "shell",
          "resource": "git -C * cat-file *",
          "effect": "allow",
        },
        {
          "action": "shell",
          "resource": "git -C * config --get *",
          "effect": "allow",
        },
        { "action": "shell", "resource": "gh pr view *", "effect": "allow" },
        { "action": "shell", "resource": "gh pr diff *", "effect": "allow" },
        { "action": "shell", "resource": "gh pr checks *", "effect": "allow" },
        // Last match wins; these exclusions must follow the allows.
        { "action": "shell", "resource": "gh pr * --web*", "effect": "deny" },
        { "action": "shell", "resource": "gh pr * -w*", "effect": "deny" },
        { "action": "shell", "resource": "gh pr * --watch*", "effect": "deny" },
        {
          "action": "shell",
          "resource": "gh pr * --allow-escape-sequences*",
          "effect": "deny",
        },
        { "action": "external_directory", "resource": "*", "effect": "deny" },
        {
          "action": "external_directory",
          "resource": "~/.local/share/workcell/review-workspaces-v2/**",
          "effect": "allow",
        },
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "delegate", "resource": "*", "effect": "deny" },
        { "action": "plan_save", "resource": "*", "effect": "deny" },
        { "action": "todowrite", "resource": "*", "effect": "deny" },
        { "action": "todoread", "resource": "*", "effect": "deny" },
        { "action": "context7_*", "resource": "*", "effect": "deny" },
        { "action": "exa_*", "resource": "*", "effect": "deny" },
        { "action": "gh_grep_*", "resource": "*", "effect": "deny" },
        { "action": "kagi_*", "resource": "*", "effect": "deny" },
        { "action": "webfetch", "resource": "*", "effect": "deny" },
        { "action": "worktree_*", "resource": "*", "effect": "deny" },
      ],
    },

    "committer": {
      "description": "Creates atomic Git commits and pull requests from completed, verified work.",
      "mode": "subagent",
      "model": "openai/gpt-6-astra",
      "request": {
        "body": {
          "temperature": 0.1,
          "reasoningEffort": "low",
          "textVerbosity": "low",
        },
      },
      "permissions": [
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "glob", "resource": "*", "effect": "allow" },
        { "action": "grep", "resource": "*", "effect": "allow" },
        { "action": "git_inspect", "resource": "*", "effect": "allow" },
        { "action": "plan_read", "resource": "*", "effect": "allow" },
        { "action": "delegation_read", "resource": "*", "effect": "allow" },
        { "action": "delegation_list", "resource": "*", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "ask" },
        { "action": "shell", "resource": "git status*", "effect": "allow" },
        { "action": "shell", "resource": "git diff*", "effect": "allow" },
        { "action": "shell", "resource": "git log*", "effect": "allow" },
        { "action": "shell", "resource": "git show*", "effect": "allow" },
        { "action": "shell", "resource": "git branch*", "effect": "allow" },
        { "action": "shell", "resource": "git rev-parse*", "effect": "allow" },
        {
          "action": "shell",
          "resource": "git symbolic-ref*",
          "effect": "allow",
        },
        { "action": "shell", "resource": "git ls-files*", "effect": "allow" },
        { "action": "shell", "resource": "git remote*", "effect": "allow" },
        {
          "action": "shell",
          "resource": "git config --get *",
          "effect": "allow",
        },
        { "action": "shell", "resource": "git add *", "effect": "allow" },
        { "action": "shell", "resource": "git add .", "effect": "deny" },
        { "action": "shell", "resource": "git add -A*", "effect": "deny" },
        { "action": "shell", "resource": "git add --all*", "effect": "deny" },
        { "action": "shell", "resource": "git add -u*", "effect": "deny" },
        {
          "action": "shell",
          "resource": "git add --update*",
          "effect": "deny",
        },
        {
          "action": "shell",
          "resource": "git apply --cached*",
          "effect": "allow",
        },
        {
          "action": "shell",
          "resource": "git restore --staged *",
          "effect": "allow",
        },
        { "action": "shell", "resource": "git commit*", "effect": "allow" },
        { "action": "shell", "resource": "git commit -a*", "effect": "deny" },
        {
          "action": "shell",
          "resource": "git commit --all*",
          "effect": "deny",
        },
        { "action": "shell", "resource": "git push*", "effect": "ask" },
        {
          "action": "shell",
          "resource": "git push --force*",
          "effect": "deny",
        },
        { "action": "shell", "resource": "git push -f*", "effect": "deny" },
        { "action": "shell", "resource": "gh auth status*", "effect": "allow" },
        { "action": "shell", "resource": "gh repo view*", "effect": "allow" },
        { "action": "shell", "resource": "gh pr status*", "effect": "allow" },
        { "action": "shell", "resource": "gh pr list*", "effect": "allow" },
        { "action": "shell", "resource": "gh pr view*", "effect": "allow" },
        { "action": "shell", "resource": "gh pr create*", "effect": "allow" },
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "lsp", "resource": "*", "effect": "deny" },
        { "action": "external_directory", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "delegate", "resource": "*", "effect": "deny" },
        { "action": "plan_save", "resource": "*", "effect": "deny" },
        { "action": "todowrite", "resource": "*", "effect": "deny" },
        { "action": "todoread", "resource": "*", "effect": "deny" },
        { "action": "context7_*", "resource": "*", "effect": "deny" },
        { "action": "exa_*", "resource": "*", "effect": "deny" },
        { "action": "gh_grep_*", "resource": "*", "effect": "deny" },
        { "action": "kagi_*", "resource": "*", "effect": "deny" },
        { "action": "webfetch", "resource": "*", "effect": "deny" },
        { "action": "worktree_*", "resource": "*", "effect": "deny" },
      ],
    },

