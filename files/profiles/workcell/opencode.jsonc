{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.6-sol",
  "small_model": "openai/gpt-5.6-luna",
  "default_agent": "plan",
  "subagent_depth": 1,
  "lsp": true,
  "formatter": true,
  "agent": {
    "plan": {
      "description": "Designs implementation-ready plans using delegated repository and external research.",
      "mode": "primary",
      "model": "openai/gpt-5.6-sol",
      "temperature": 0.3,
      "options": { "reasoningEffort": "high", "textVerbosity": "medium" },
      "prompt": "You are the software-design primary agent.\n\nProduce an implementation-ready plan, but do not start implementation.\n\nUse `explore` through async delegation for repository facts and `researcher` through async delegation for external facts. Ask the user only for decisions that cannot be resolved from the repository, authoritative documentation, or safe defaults.\n\nAsk one decision-focused question at a time. Do not interview mechanically. Group dependent facts internally and stop questioning once the remaining uncertainty does not materially affect architecture, scope, safety, migration, or acceptance criteria.\n\nDo not delegate implementation, testing, debugging, review, or documentation application. Those belong to the build workflow after the plan is accepted.\n\nThe final plan must include:\n- Scope and non-goals\n- Architectural decisions and rationale\n- Affected components and interfaces\n- Ordered implementation tasks\n- Migration and rollback strategy\n- Verification and acceptance criteria\n- Unresolved risks and assumptions\n\nPersist the final plan through `plan_save` when that tool is available.",
      "permission": {
        "question": "allow",
        "skill": "allow",
        "delegate": "allow",
        "delegation_read": "allow",
        "delegation_list": "allow",
        "plan_save": "allow",
        "plan_read": "allow",

        "edit": "deny",
        "write": "deny",
        "bash": "deny",
        "read": "deny",
        "glob": "deny",
        "grep": "deny",
        "lsp": "deny",
        "formatter": "deny",
        "task": "deny",
        "todowrite": "deny",
        "todoread": "deny",
        "external_directory": "deny",

        "context7_*": "deny",
        "exa_*": "deny",
        "gh_grep_*": "deny",
        "kagi_*": "deny",
        "webfetch": "deny",
        "worktree_*": "deny",
      },
    },

    "build": {
      "description": "Coordinates implementation, verification, documentation, debugging, and independent review.",
      "mode": "primary",
      "model": "openai/gpt-5.6-sol",
      "temperature": 0.3,
      "options": { "reasoningEffort": "medium", "textVerbosity": "low" },
      "prompt": "You are the build orchestration primary agent. You do not edit files or execute shell commands directly.\n\nRoute work as follows:\n- `coder`: implementation and routine repair\n- `debugger`: difficult diagnosis and corrective implementation\n- `tester`: independent verification\n- `scribe`: documentation files\n- `committer`: atomic Git commits and explicitly authorized pull-request creation\n- `explore`: asynchronous repository investigation\n- `researcher`: asynchronous external documentation and ecosystem research\n- `reviewer`: asynchronous independent review after implementation and testing\n\nUse `task` only for write-capable or command-executing agents: `coder`, `debugger`, `tester`, `scribe`, and `committer`.\nUse `delegate` only for read-only agents: `explore`, `researcher`, and `reviewer`.\n\nNative task prompts must be self-contained and execution-complete. Include the accepted scope and acceptance criteria, required philosophy skills, relevant files or delegation artifacts, constraints, and expected verification. Explicitly require the child to continue in the same invocation until completion or a concrete tooling blocker. Treat every native task call as context-isolated: never refer a fresh child to a prior child prompt, and restate the full original scope on every retry.\n\nDo not treat a coder's success claim as verification. Require independent tester evidence. When a test fails, determine whether the failure indicates an implementation defect or an infrastructure problem before delegating repair.\n\nA progress statement, intention to begin, or response without changed-file and command evidence is not a completed task result. Reissue the coder task once with the complete original scope and an explicit continue-to-terminal-result instruction. If it repeats, treat it as a write-delegation failure and route the concrete scope plus failed-response evidence to `debugger`; do not report implementation as complete.\n\nBefore delegating to `committer`, wait for the requested implementation, independent verification, and review unless the user explicitly asks for an earlier commit. Pass a compact handoff containing the accepted plan or requirements, intended commit boundaries, changed files, verification and review outcomes, related issue references, current and target branches, remote, and whether push or pull-request creation is authorized. Include relevant delegation IDs when useful; do not ask `committer` to rediscover work already completed by other agents.\n\nDo not poll background delegations. Continue productive orchestration and wait for task notifications. Use `delegation_read` when a completion notification arrives or when recovering context after compaction.\n\nAfter every child result, decide whether it satisfies the accepted plan and its acceptance criteria. Finish with implemented scope, changed components, verification evidence, review outcome, commit or pull-request outcome, remaining risks, and blockers.",
      "permission": {
        "question": "allow",
        "skill": "allow",
        "plan_read": "allow",

        "delegate": "allow",
        "delegation_read": "allow",
        "delegation_list": "allow",

        "task": "allow",

        "worktree_*": "allow",

        "edit": "deny",
        "write": "deny",
        "bash": "deny",
        "read": "deny",
        "glob": "deny",
        "grep": "deny",
        "lsp": "allow",
        "todowrite": "deny",
        "todoread": "deny",
        "external_directory": "deny",

        "context7_*": "deny",
        "exa_*": "deny",
        "gh_grep_*": "deny",
        "kagi_*": "deny",
        "webfetch": "deny",
      },
    },

    "coder": {
      "description": "Implements bounded changes and performs immediate implementation-level verification.",
      "mode": "subagent",
      // "model": "opencode-go/kimi-k3",
      "model": "openai/gpt-5.6-sol",
      "temperature": 0.1,
      "options": { "reasoningEffort": "medium", "textVerbosity": "low" },
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "lsp": "allow",
        "formatter": "allow",
        "skill": "allow",
        "edit": "allow",
        "write": "allow",
        "bash": "allow",

        "external_directory": "deny",
        "task": "deny",
        "delegate": "deny",
        "delegation_read": "deny",
        "delegation_list": "deny",
        "plan_read": "allow",
        "plan_save": "deny",
        "todowrite": "deny",
        "todoread": "deny",

        "context7_*": "deny",
        "exa_*": "deny",
        "gh_grep_*": "deny",
        "kagi_*": "deny",
        "webfetch": "deny",
        "worktree_*": "deny",
      },
    },

    "debugger": {
      "description": "Diagnoses difficult failures and applies narrowly scoped corrective changes.",
      "mode": "subagent",
      "model": "openai/gpt-5.6-sol",
      "temperature": 0.1,
      "options": { "reasoningEffort": "high", "textVerbosity": "low" },
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "lsp": "allow",
        "skill": "allow",
        "edit": "allow",
        "write": "allow",
        "bash": "allow",

        "external_directory": "deny",
        "task": "deny",
        "delegate": "deny",
        "delegation_read": "deny",
        "delegation_list": "deny",
        "plan_read": "allow",
        "plan_save": "deny",
        "todowrite": "deny",
        "todoread": "deny",

        "context7_*": "deny",
        "exa_*": "deny",
        "gh_grep_*": "deny",
        "kagi_*": "deny",
        "webfetch": "deny",
        "worktree_*": "deny",
      },
    },

    "tester": {
      "description": "Runs requested verification independently without modifying source files or repairing failures.",
      "mode": "subagent",
      "model": "openai/gpt-5.6-luna",
      "options": { "reasoningEffort": "low", "textVerbosity": "low" },

      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "bash": "allow",
        "lsp": "allow",

        "edit": "deny",
        "write": "deny",
        "external_directory": "deny",
        "task": "deny",
        "delegate": "deny",
        "delegation_read": "deny",
        "delegation_list": "deny",
        "plan_read": "allow",
        "plan_save": "deny",
        "todowrite": "deny",
        "todoread": "deny",

        "context7_*": "deny",
        "exa_*": "deny",
        "gh_grep_*": "deny",
        "kagi_*": "deny",
        "webfetch": "deny",
        "worktree_*": "deny",
      },
    },

    "explore": {
      "description": "Performs read-only repository investigation and returns file-and-line evidence.",
      "mode": "subagent",
      "model": "openai/gpt-5.6-luna",
      "temperature": 0.2,
      "options": { "reasoningEffort": "medium", "textVerbosity": "medium" },
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "lsp": "allow",
        "git_inspect": "allow",

        "edit": "deny",
        "write": "deny",
        "bash": "deny",
        "external_directory": "deny",
        "task": "deny",
        "delegate": "deny",
        "delegation_read": "deny",
        "delegation_list": "deny",
        "plan_read": "deny",
        "plan_save": "deny",
        "todowrite": "deny",
        "todoread": "deny",

        "context7_*": "deny",
        "exa_*": "deny",
        "gh_grep_*": "deny",
        "kagi_*": "deny",
        "webfetch": "deny",
        "worktree_*": "deny",
      },
    },

    "researcher": {
      "description": "Researches external technical facts using authoritative sources and explicit citations.",
      "mode": "subagent",
      "model": "openai/gpt-5.6-terra",
      "temperature": 0.2,
      "options": { "reasoningEffort": "medium", "textVerbosity": "medium" },
      "permission": {
        "context7_*": "allow",
        "exa_*": "allow",
        "gh_grep_*": "allow",
        "webfetch": "allow",

        "edit": "deny",
        "write": "deny",
        "bash": "deny",
        "read": "deny",
        "glob": "deny",
        "grep": "deny",
        "lsp": "deny",
        "external_directory": "deny",
        "task": "deny",
        "delegate": "deny",
        "delegation_read": "deny",
        "delegation_list": "deny",
        "plan_read": "deny",
        "plan_save": "deny",
        "todowrite": "deny",
        "todoread": "deny",

        "kagi_*": "deny",
        "worktree_*": "deny",
      },
    },

    "scribe": {
      "description": "Writes project documentation while preserving repository conventions.",
      "mode": "subagent",
      "model": "openai/gpt-5.6-luna",
      "temperature": 0.1,
      "options": { "reasoningEffort": "medium", "textVerbosity": "low" },
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "edit": "allow",
        "write": "allow",

        "bash": "deny",
        "lsp": "deny",
        "external_directory": "deny",
        "task": "deny",
        "delegate": "deny",
        "delegation_read": "deny",
        "delegation_list": "deny",
        "plan_read": "deny",
        "plan_save": "deny",
        "todowrite": "deny",
        "todoread": "deny",

        "context7_*": "deny",
        "exa_*": "deny",
        "gh_grep_*": "deny",
        "kagi_*": "deny",
        "webfetch": "deny",
        "worktree_*": "deny",
      },
    },

    "reviewer": {
      "description": "Performs evidence-based, read-only review against the accepted plan and verification results.",
      "mode": "subagent",
      "model": "openai/gpt-5.6-sol",
      "temperature": 0.1,
      "options": { "reasoningEffort": "high", "textVerbosity": "medium" },
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "lsp": "allow",
        "git_inspect": "allow",
        "skill": "allow",
        "plan_read": "allow",
        "delegation_read": "allow",
        "delegation_list": "allow",

        "edit": "deny",
        "write": "deny",
        "bash": "deny",
        "external_directory": "deny",
        "task": "deny",
        "delegate": "deny",
        "plan_save": "deny",
        "todowrite": "deny",
        "todoread": "deny",

        "context7_*": "deny",
        "exa_*": "deny",
        "gh_grep_*": "deny",
        "kagi_*": "deny",
        "webfetch": "deny",
        "worktree_*": "deny",
      },
    },

    "committer": {
      "description": "Creates atomic Git commits and pull requests from completed, verified work.",
      "mode": "subagent",
      "model": "openai/gpt-5.6-sol",
      "temperature": 0.1,
      "options": { "reasoningEffort": "low", "textVerbosity": "low" },
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "git_inspect": "allow",
        "plan_read": "allow",
        "delegation_read": "allow",
        "delegation_list": "allow",

        "bash": {
          "*": "deny",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git show*": "allow",
          "git branch*": "allow",
          "git rev-parse*": "allow",
          "git symbolic-ref*": "allow",
          "git ls-files*": "allow",
          "git remote*": "allow",
          "git config --get *": "allow",
          "git add *": "allow",
          "git add .": "deny",
          "git add -A*": "deny",
          "git add --all*": "deny",
          "git add -u*": "deny",
          "git add --update*": "deny",
          "git apply --cached*": "allow",
          "git restore --staged *": "allow",
          "git commit*": "allow",
          "git commit -a*": "deny",
          "git commit --all*": "deny",
          "git push*": "ask",
          "git push --force*": "deny",
          "git push -f*": "deny",
          "gh auth status*": "allow",
          "gh repo view*": "allow",
          "gh pr status*": "allow",
          "gh pr list*": "allow",
          "gh pr view*": "allow",
          "gh pr create*": "allow",
        },

        "edit": "deny",
        "write": "deny",
        "lsp": "deny",
        "external_directory": "deny",
        "task": "deny",
        "delegate": "deny",
        "plan_save": "deny",
        "todowrite": "deny",
        "todoread": "deny",

        "context7_*": "deny",
        "exa_*": "deny",
        "gh_grep_*": "deny",
        "kagi_*": "deny",
        "webfetch": "deny",
        "worktree_*": "deny",
      },
    },

    "metadata": {
      "description": "Generates constrained metadata for completed delegation artifacts.",
      "mode": "subagent",
      "hidden": true,
      "model": "openai/gpt-5.6-luna",
      "temperature": 0,
      "options": { "reasoningEffort": "low", "textVerbosity": "low" },
      "permission": {
        "edit": "deny",
        "write": "deny",
        "bash": "deny",
        "read": "deny",
        "glob": "deny",
        "grep": "deny",
        "lsp": "deny",
        "external_directory": "deny",
        "task": "deny",
        "delegate": "deny",
        "delegation_read": "deny",
        "delegation_list": "deny",
        "plan_read": "deny",
        "plan_save": "deny",
        "todowrite": "deny",
        "todoread": "deny",

        "context7_*": "deny",
        "exa_*": "deny",
        "gh_grep_*": "deny",
        "kagi_*": "deny",
        "webfetch": "deny",
        "worktree_*": "deny",
      },
    },
  },

  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
    },
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp/oauth",
      "enabled": true,
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": true,
    },
  },

  "permission": {
    "*": "deny",

    "read": "deny",
    "glob": "deny",
    "grep": "deny",
    "lsp": "deny",
    "edit": "deny",
    "write": "deny",
    "bash": "deny",
    "external_directory": "deny",

    "task": "deny",
    "delegate": "deny",
    "delegation_read": "deny",
    "delegation_list": "deny",

    "question": "deny",
    "plan_read": "deny",
    "plan_save": "deny",
    "todowrite": "deny",
    "todoread": "deny",

    "context7_*": "deny",
    "exa_*": "deny",
    "gh_grep_*": "deny",
    "kagi_*": "deny",
    "webfetch": "deny",
    "worktree_*": "deny",
  },

  "instructions": ["./tools/philosophy.md"],

  "plugin": [
    "opencode-vibeguard@0.1.0",
    "@plannotator/opencode@0.27.11",
    "@tarquinen/opencode-dcp@3.1.15",
    "@franlol/opencode-md-table-formatter@0.0.6",
    "@plannotator/opencode@0.27.12",
  ],
}
