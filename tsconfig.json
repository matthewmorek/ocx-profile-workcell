{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "allowJs": false,
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "types": ["bun"]
  },
  "include": ["files/plugins/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts"]
}
